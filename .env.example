# Copy to .env.local for local dev. On Vercel, add these under Project → Settings → Environment Variables.

# Supabase → Project Settings → API (or Data API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key   # server-only, never share

# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional: change the model (default gpt-5.4-mini)
# OPENAI_MODEL=gpt-5.5

# Password to open the app. Leave empty locally; ALWAYS set it on Vercel.
APP_PASSWORD=
